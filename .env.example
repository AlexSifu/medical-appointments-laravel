APP_NAME="Nexa Salud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Zona horaria de presentación (la BD almacena UTC)
APP_DISPLAY_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQL Server. Usuario/contraseña vacíos = autenticación integrada de Windows.
# En producción use un login con el rol nexa_app_role (nunca db_owner).
DB_CONNECTION=sqlsrv
DB_HOST=localhost
DB_PORT=
DB_DATABASE=ReservasMedicasWeb
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true
# Base de datos para pruebas de integración (php artisan test --group=integration)
DB_TEST_DATABASE=ReservasMedicasWeb_Test

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=nexa_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@nexasalud.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Cuentas demo para php artisan clinic:seed-demo (SOLO desarrollo).
# Defina contraseñas propias en .env. Nunca las suba al repositorio.
# ---------------------------------------------------------------------------
DEMO_SUPERADMIN_USER=superadmin
DEMO_SUPERADMIN_EMAIL=superadmin@nexasalud.test
DEMO_SUPERADMIN_PASSWORD=
DEMO_ADMIN_USER=administrador
DEMO_ADMIN_EMAIL=administrador@nexasalud.test
DEMO_ADMIN_PASSWORD=
DEMO_RECEPTION_USER=recepcion
DEMO_RECEPTION_EMAIL=recepcion@nexasalud.test
DEMO_RECEPTION_PASSWORD=
DEMO_DOCTOR_USER=medico
DEMO_DOCTOR_EMAIL=medico@nexasalud.test
DEMO_DOCTOR_PASSWORD=
DEMO_PATIENT_USER=paciente
DEMO_PATIENT_EMAIL=paciente@nexasalud.test
DEMO_PATIENT_PASSWORD=
DEMO_AUDITOR_USER=auditor
DEMO_AUDITOR_EMAIL=auditor@nexasalud.test
DEMO_AUDITOR_PASSWORD=
